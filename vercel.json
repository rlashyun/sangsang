{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "regions": ["icn1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{.venv/**,.uv-cache/**,tests/**,data/**,supabase/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/partner-sync",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/police-sync",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/embedding-sync",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/partner-sync-afternoon",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/police-sync-afternoon",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/embedding-sync-afternoon",
      "schedule": "0 14 * * *"
    }
  ]
}
